{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timelabs-npo.github.io/genomeatlas/schemas/probe.schema.json",
  "title": "GenomeAtlas probe receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "toolId",
    "state",
    "probeTimestamp",
    "summary",
    "inputContract",
    "outputContract",
    "evidence",
    "result",
    "review"
  ],
  "properties": {
    "kind": { "const": "probe-receipt" },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "state": {
      "type": "string",
      "enum": [
        "DECLARED",
        "DISCOVERED",
        "PROBED",
        "EXECUTED",
        "AUTH_REQUIRED",
        "BLOCKED_EXECUTION",
        "NOT_DEPLOYED"
      ]
    },
    "probeTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "inputContract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "outputContract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "hashStatus", "sha256"],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "hashStatus": {
          "type": "string",
          "enum": ["measured", "not_measured"]
        },
        "sha256": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "hashStatus": { "const": "measured" } },
            "required": ["hashStatus"]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "hashStatus": { "const": "not_measured" } },
            "required": ["hashStatus"]
          },
          "then": {
            "properties": {
              "sha256": { "type": "null" }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "exitCode"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["DETECTED", "NOT_DETECTED", "FAILED", "UNKNOWN"]
        },
        "exitCode": { "type": "integer" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified"],
      "properties": {
        "verified": { "type": "boolean" },
        "reviewer": {
          "type": ["string", "null"],
          "maxLength": 200
        }
      }
    }
  }
}
