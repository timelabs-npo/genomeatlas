{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenomeAtlas unverified probe result",
  "description": "A schema-valid receipt is a claim, not an independently verified result. Hash values are supplied claims; preview does not check artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "endpoint_alias",
    "observed_at_utc",
    "command_tool_id",
    "exit_code",
    "input_hashes",
    "output_hashes",
    "test_scope",
    "redacted",
    "claimed_result",
    "verification"
  ],
  "properties": {
    "schema": {
      "const": "genomeatlas.probe-result/1"
    },
    "endpoint_alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
      "maxLength": 64
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z(?![\\s\\S])"
    },
    "command_tool_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}(?![\\s\\S])",
      "maxLength": 96
    },
    "exit_code": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "input_hashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "output_hashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "test_scope": {
      "enum": [
        "synthetic",
        "live"
      ]
    },
    "redacted": {
      "const": true
    },
    "claimed_result": {
      "enum": [
        "PASS",
        "FAIL",
        "AUTH_REQUIRED",
        "NOT_TESTED"
      ]
    },
    "verification": {
      "const": "UNVERIFIED"
    }
  }
}
