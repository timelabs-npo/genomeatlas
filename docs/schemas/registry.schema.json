{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenomeAtlas registry v1",
  "description": "Shape only; validated imports remain untrusted. Runtime also rejects unsafe text, duplicate IDs and oversized UTF-8 documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "registry"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "states",
          "evidenceIds",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "states": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exposed",
              "installed",
              "authenticated",
              "probed",
              "executed"
            ],
            "properties": {
              "exposed": {
                "enum": [
                  "unknown",
                  "yes",
                  "no",
                  "blocked",
                  "not-tested"
                ]
              },
              "installed": {
                "enum": [
                  "unknown",
                  "yes",
                  "no",
                  "blocked",
                  "not-tested"
                ]
              },
              "authenticated": {
                "enum": [
                  "unknown",
                  "yes",
                  "no",
                  "blocked",
                  "not-tested"
                ]
              },
              "probed": {
                "enum": [
                  "unknown",
                  "yes",
                  "no",
                  "blocked",
                  "not-tested"
                ]
              },
              "executed": {
                "enum": [
                  "unknown",
                  "yes",
                  "no",
                  "blocked",
                  "not-tested"
                ]
              }
            }
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 80
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    }
  }
}
