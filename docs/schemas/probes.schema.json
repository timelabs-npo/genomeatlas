{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenomeAtlas probes v1",
  "description": "Shape only; validated imports remain untrusted. Runtime also rejects unsafe text, duplicate IDs and oversized UTF-8 documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "probes"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "toolId",
          "observedAt",
          "dimension",
          "state",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "toolId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 80
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "dimension": {
            "enum": [
              "exposed",
              "installed",
              "authenticated",
              "probed",
              "executed"
            ]
          },
          "state": {
            "enum": [
              "unknown",
              "yes",
              "no",
              "blocked",
              "not-tested"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    }
  }
}
